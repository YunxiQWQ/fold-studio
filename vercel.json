{
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/toolbox/index.html" },
    { "source": "/fold", "destination": "/index.html" },
    { "source": "/fold/", "destination": "/index.html" },
    { "source": "/fold/:path*", "destination": "/:path*" }
  ]
}
