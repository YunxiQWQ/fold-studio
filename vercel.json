{
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/fold", "destination": "/fold.html" },
    { "source": "/fold/", "destination": "/fold.html" },
    { "source": "/fold/index.html", "destination": "/fold.html" },
    { "source": "/fold/:path*", "destination": "/:path*" }
  ]
}
